<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7c3e9a52-4b1f-4d8e-9a6c-2f5b8e1d3a47</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Quality Tractor Parts</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="QTP Email Signature"/>
  <Description DefaultValue="Adds the standard Quality Tractor Parts signature to new emails, replies and forwards."/>
  <IconUrl DefaultValue="https://qtp-it-services.github.io/QTPSignatures/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://qtp-it-services.github.io/QTPSignatures/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.qtponline.com/"/>
  <AppDomains>
    <AppDomain>https://qtp-it-services.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://qtp-it-services.github.io/QTPSignatures/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/commands.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://qtp-it-services.github.io/QTPSignatures/launchevent.js"/>
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
